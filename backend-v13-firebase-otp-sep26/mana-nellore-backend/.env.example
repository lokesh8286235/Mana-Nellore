# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/mana_nellore
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=change-me-to-a-strong-password
DEV_OTP=true
# Phones (comma-separated, 10-digit) that receive dev_code in the send-otp
# response. Anyone NOT on this list never gets a code back — without it,
# DEV_OTP=true lets anyone log in as anyone. Example:
# DEV_OTP_PHONES=98XXXXXXXX,97XXXXXXXX
PORT=8080
